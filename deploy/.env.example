# Copy to deploy/.env (chmod 600). Never commit the real file.

# Public hostname; its DNS A/AAAA record must point at this server.
DOMAIN=pay.example.com

# Block producer seed: `orctl export-seed -key proposer.json`.
# Prefer injecting this from a secrets manager over keeping it on disk.
ORP_PROPOSER_SEED=

# Optional devnet/testnet faucet seed. Leave empty to disable the faucet.
ORPAY_FAUCET_SEED=

# Wallet addresses allowed to approve partner apps (comma-separated).
ORPAY_ADMINS=

# Money providers: configure Paystack, Flutterwave, or both (test keys first).
# Flutterwave also needs the "secret hash" you set in its dashboard for webhooks.
# ORP_ISSUER_SEED is the NGN issuer (orctl export-seed -key issuer.json); its
# address must match the NGN asset in genesis.json. Real money needs a
# licensed custody partner (e.g. a bank or MFB) and legal sign-off.
PAYSTACK_SECRET_KEY=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
ORP_ISSUER_SEED=

# Monitoring: incoming webhook for alerts (Slack, Discord, Google Chat...).
ALERT_WEBHOOK=
