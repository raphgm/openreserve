# Copy to deploy/.env (chmod 600). Never commit the real file.

# Public hostname; its DNS A/AAAA record must point at this server.
DOMAIN=pay.example.com

# Block producer seed: `orctl export-seed -key proposer.json`.
# Prefer injecting this from a secrets manager over keeping it on disk.
ORP_PROPOSER_SEED=

# Optional devnet/testnet faucet seed. Leave empty to disable the faucet.
ORPAY_FAUCET_SEED=

# Wallet addresses allowed to approve partner apps (comma-separated).
ORPAY_ADMINS=

# Paystack secret key (sk_test_... to try, sk_live_... for real money) and the
# NGN issuer seed (orctl export-seed -key issuer.json). The issuer address must
# match the NGN asset in genesis.json. Real money needs a licensed partner.
PAYSTACK_SECRET_KEY=
ORP_ISSUER_SEED=
